# Copy to .env and fill in. Never commit .env.
# REDCap API: the project's API URL (ends with /api/) and a token for a user with API export rights.
REDCAP_API_URL=https://redcap.example.org/api/
REDCAP_API_TOKEN=
# Admin key for the Data & pipeline page and the admin API. Leave empty to generate one on first start (printed once and saved in data/).
ADHMAT_ADMIN_KEY=
# Shared secret for the REDCap Data Entry Trigger URL. Leave empty to generate one.
ADHMAT_WEBHOOK_SECRET=
# Optional overrides
# PORT=8080
# HOST=127.0.0.1
# SYNC_INTERVAL_MINUTES=60
